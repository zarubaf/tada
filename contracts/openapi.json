{
  "openapi": "3.1.0",
  "info": {
    "title": "tada",
    "description": "The tada HTTP API. The list of problem codes of each operation is open.",
    "license": {
      "name": "Apache-2.0"
    },
    "version": "1"
  },
  "paths": {
    "/api/v1/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Lists the events that the caller can see, in the order of their keys.",
        "operationId": "list_events",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "The page size: 1 to 200. The default is 50.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 200,
              "minimum": 1
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The `next_cursor` of the previous page.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "malformed-request",
          "unauthenticated",
          "organization-required",
          "unavailable",
          "internal"
        ]
      },
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Creates an event in the caller's organization.",
        "description": "If an event with the same `id` and the same content exists, the response is this event with the\nstatus 200, and nothing changes.",
        "operationId": "create_event",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The event exists with this ID and the same content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "201": {
            "description": "The new event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "malformed-request",
          "unauthenticated",
          "organization-required",
          "forbidden",
          "payload-too-large",
          "unsupported-media-type",
          "validation-failed",
          "unavailable",
          "internal"
        ]
      }
    },
    "/api/v1/telegram/link-codes": {
      "post": {
        "tags": [
          "telegram"
        ],
        "summary": "Creates a link code for the calling member.",
        "operationId": "create_telegram_link_code",
        "responses": {
          "201": {
            "description": "The new code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelegramLinkCode"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "unauthenticated",
          "organization-required",
          "forbidden",
          "unavailable",
          "internal"
        ]
      }
    },
    "/api/v1/telegram/link-requests": {
      "get": {
        "tags": [
          "telegram"
        ],
        "summary": "Lists the open link requests of the calling member.",
        "operationId": "list_telegram_link_requests",
        "responses": {
          "200": {
            "description": "The open requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelegramLinkRequestPage"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "unauthenticated",
          "organization-required",
          "unavailable",
          "internal"
        ]
      }
    },
    "/api/v1/telegram/link-requests/{request_id}/confirm": {
      "post": {
        "tags": [
          "telegram"
        ],
        "summary": "Confirms a link request. Only then does tada bind the Telegram account to the member.",
        "operationId": "confirm_telegram_link",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "description": "The ID of the link request.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The account is linked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelegramLink"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "unauthenticated",
          "organization-required",
          "forbidden",
          "not-found",
          "invalid-transition",
          "unavailable",
          "internal"
        ]
      }
    },
    "/api/v1/sign-in/requests": {
      "post": {
        "tags": [
          "sign-in"
        ],
        "summary": "Asks for a magic link. The answer is the same for each address (ADR 0008).\nOnly a member gets a mail. Too many requests for one address or from one client get\n`rate-limited` with `Retry-After` (ADR 0056).",
        "operationId": "request_sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "The request is accepted. The body is empty."
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "malformed-request",
          "forbidden",
          "payload-too-large",
          "unsupported-media-type",
          "rate-limited",
          "unavailable",
          "internal"
        ]
      }
    },
    "/api/v1/sign-in/magic-link": {
      "post": {
        "tags": [
          "sign-in"
        ],
        "summary": "Signs in with the token of a magic link. The token works once.\nThe response sets the session cookie.",
        "operationId": "redeem_magic_link",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemMagicLinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The new session. The `Set-Cookie` header holds its token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "malformed-request",
          "unauthenticated",
          "forbidden",
          "payload-too-large",
          "unsupported-media-type",
          "unavailable",
          "internal"
        ]
      }
    },
    "/api/v1/session": {
      "get": {
        "tags": [
          "sign-in"
        ],
        "summary": "Reads the session of the request. A session without an organization also gets its information.",
        "operationId": "get_session",
        "responses": {
          "200": {
            "description": "The session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "unauthenticated",
          "unavailable",
          "internal"
        ]
      }
    },
    "/api/v1/session/organization": {
      "post": {
        "tags": [
          "sign-in"
        ],
        "summary": "Chooses or changes the organization of the session (ADR 0056). The token stays the same.",
        "operationId": "choose_organization",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChooseOrganizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The changed session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "malformed-request",
          "unauthenticated",
          "forbidden",
          "not-found",
          "payload-too-large",
          "unsupported-media-type",
          "unavailable",
          "internal"
        ]
      }
    },
    "/api/v1/sign-out": {
      "post": {
        "tags": [
          "sign-in"
        ],
        "summary": "Signs out: ends the session and clears the cookie. It also succeeds without a session.",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "The session ended."
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "forbidden",
          "unavailable",
          "internal"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChooseOrganizationRequest": {
        "type": "object",
        "description": "The input of `choose_organization`.",
        "required": [
          "organization_id"
        ],
        "properties": {
          "organization_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateEventRequest": {
        "type": "object",
        "description": "The input of `CreateEvent`.",
        "required": [
          "key",
          "name"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The UUIDv7 of the new event. A client that sends it can retry the request safely."
          },
          "key": {
            "type": "string",
            "description": "Two to eight capital letters and digits, unique in the organization.",
            "example": "TEST30"
          },
          "name": {
            "type": "string",
            "description": "1 to 200 characters.",
            "example": "Open Day Testwil"
          },
          "time_zone": {
            "type": [
              "string",
              "null"
            ],
            "description": "An IANA time zone. The default is `Europe/Zurich`."
          }
        }
      },
      "Event": {
        "type": "object",
        "description": "An event.",
        "required": [
          "id",
          "key",
          "name",
          "time_zone",
          "version",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "description": "The short key of the event, unique in its organization, for example `FLY28`."
          },
          "name": {
            "type": "string"
          },
          "time_zone": {
            "type": "string",
            "description": "The IANA time zone of the event, for example `Europe/Zurich`."
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "The record version. A command that changes the event needs it."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventPage": {
        "type": "object",
        "description": "One page of events.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "The cursor of the next page. It is absent on the last page."
          }
        }
      },
      "MembershipSummary": {
        "type": "object",
        "description": "A membership of the signed-in user.",
        "required": [
          "organization_id",
          "name",
          "role"
        ],
        "properties": {
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "The name of the organization."
          },
          "role": {
            "$ref": "#/components/schemas/OrganizationRole"
          }
        }
      },
      "OrganizationRole": {
        "type": "string",
        "description": "The role of a member in an organization.",
        "enum": [
          "owner",
          "admin",
          "member"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "An error response. `detail` never repeats input values.",
        "required": [
          "type",
          "code",
          "title",
          "status",
          "instance",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "The URL of the code in the public catalog."
          },
          "code": {
            "type": "string",
            "description": "The stable problem code. Clients react to this field. The list of codes is open."
          },
          "title": {
            "type": "string",
            "description": "A short, stable English text for developers."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "An English text about this case, for developers. Clients never show it to members."
          },
          "instance": {
            "type": "string",
            "description": "`urn:uuid:` and the request ID."
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemError"
            },
            "description": "The invalid values of a `validation-failed` problem."
          }
        }
      },
      "ProblemError": {
        "type": "object",
        "description": "One invalid value.",
        "required": [
          "pointer",
          "code"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "description": "A JSON pointer to the value in the request body, for example `/key`."
          },
          "code": {
            "type": "string",
            "description": "The reason, for example `taken`. The list of codes is open."
          }
        }
      },
      "RedeemMagicLinkRequest": {
        "type": "object",
        "description": "The input of a sign-in with a magic link.",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the fragment of the magic link."
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "description": "The signed-in user and the organization of the session.",
        "required": [
          "user_id",
          "display_name",
          "memberships"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "organization": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MembershipSummary",
                "description": "The organization of the session. It is absent until the member chooses one (ADR 0056)."
              },
              {
                "type": "null"
              }
            ]
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipSummary"
            },
            "description": "All memberships of the user, in the order of the organization names."
          }
        }
      },
      "SignInRequest": {
        "type": "object",
        "description": "The input of a sign-in request.",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "The email address of the member."
          }
        }
      },
      "TelegramLink": {
        "type": "object",
        "description": "The linked Telegram account.",
        "required": [
          "telegram_user_id"
        ],
        "properties": {
          "telegram_user_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "TelegramLinkCode": {
        "type": "object",
        "description": "A new link code. The member sends it to the bot within ten minutes.",
        "required": [
          "code",
          "expires_at"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The code. It works once. The server shows it only in this response."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TelegramLinkRequest": {
        "type": "object",
        "description": "A Telegram account that sent a code of the member, and that waits for the confirmation.",
        "required": [
          "id",
          "telegram_user_id",
          "telegram_name",
          "claimed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "telegram_user_id": {
            "type": "integer",
            "format": "int64"
          },
          "telegram_name": {
            "type": "string",
            "description": "The name of the Telegram account, as Telegram sends it."
          },
          "claimed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TelegramLinkRequestPage": {
        "type": "object",
        "description": "The open link requests of the member. A member has few, so the list has one page.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TelegramLinkRequest"
            }
          }
        }
      }
    }
  }
}
