          "unauthenticated",
          "organization-required",
          "forbidden",
          "not-found",
          "record-version-conflict",
          "invalid-transition",
          "payload-too-large",
          "unsupported-media-type",
          "unavailable",
          "internal"
        ]
      }
    },
    "/api/v1/invitations": {
      "get": {
        "tags": [
          "members"
        ],
        "summary": "Lists the pending invitations, the oldest first. Only owners and admins see them.",
        "operationId": "list_invitations",
        "responses": {
          "200": {
            "description": "All pending invitations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationPage"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "unauthenticated",
          "organization-required",
          "forbidden",
          "unavailable",
          "internal"
        ]
      },
      "post": {
        "tags": [
          "members"
        ],
        "summary": "Invites a person into the organization. The worker sends the invitation mail.",
        "description": "A pending invitation of the same email address is revoked. If an invitation with the same `id`\nand the same content exists, the response is this invitation with the status 200.",
        "operationId": "invite_member",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteMemberRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The invitation exists with this ID and the same content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invitation"
                }
              }
            }
          },
          "201": {
            "description": "The new invitation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invitation"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "malformed-request",
          "unauthenticated",
          "organization-required",
          "forbidden",
          "payload-too-large",
          "unsupported-media-type",
          "validation-failed",
          "unavailable",
          "internal"
        ]
      }
    },
    "/api/v1/invitations/{invitation_id}/revoke": {
      "post": {
        "tags": [
          "members"
        ],
        "summary": "Revokes a pending invitation. Its links stop working at once.\nOnly owners and admins can do this.",
        "operationId": "revoke_invitation",
        "parameters": [
          {
            "name": "invitation_id",
            "in": "path",
            "description": "The ID of the invitation.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The invitation is revoked."
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "malformed-request",
          "unauthenticated",
          "organization-required",
          "forbidden",
          "not-found",
          "unavailable",
          "internal"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddEventMembershipRequest": {
        "type": "object",
        "description": "The input of `AddEventMembership`.",
        "required": [
          "user_id",
          "event_role"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "A member of the caller's organization."
          },
          "event_role": {
            "$ref": "#/components/schemas/EventRole"
          }
        }
      },
      "ChangeEventRoleRequest": {
        "type": "object",
        "description": "The input of `ChangeEventRole`.",
        "required": [
          "event_role",
          "expected_version"
        ],
        "properties": {
          "event_role": {
            "$ref": "#/components/schemas/EventRole"
          },
          "expected_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "ChooseOrganizationRequest": {
        "type": "object",
        "description": "The input of `choose_organization`.",
        "required": [
          "organization_id"
        ],
        "properties": {
          "organization_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateEventRequest": {
        "type": "object",
        "description": "The input of `CreateEvent`.",
        "required": [
          "key",
          "name"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The UUIDv7 of the new event. A client that sends it can retry the request safely."
          },
          "key": {
            "type": "string",
            "description": "Two to eight capital letters and digits, unique in the organization.",
            "example": "TEST30"
          },
          "name": {
            "type": "string",
            "description": "1 to 200 characters.",
            "example": "Open Day Testwil"
          },
          "time_zone": {
            "type": [
              "string",
              "null"
            ],
            "description": "An IANA time zone. The default is `Europe/Zurich`."
          }
        }
      },
      "Event": {
        "type": "object",
        "description": "An event.",
        "required": [
          "id",
          "key",
          "name",
          "time_zone",
          "version",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "description": "The short key of the event, unique in its organization, for example `FLY28`."
          },
          "name": {
            "type": "string"
          },
          "time_zone": {
            "type": "string",
            "description": "The IANA time zone of the event, for example `Europe/Zurich`."
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "The record version. A command that changes the event needs it."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventMembership": {
        "type": "object",
        "description": "The event role of one member in one event.",
        "required": [
          "user_id",
          "display_name",
          "event_role",
          "version",
          "created_at"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "event_role": {
            "$ref": "#/components/schemas/EventRole"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "The record version. A command that changes the event membership needs it."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventMembershipPage": {
        "type": "object",
        "description": "The event memberships of an event. An event has few, so the list has one page.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventMembership"
            }
          }
        }
      },
      "EventPage": {
        "type": "object",
        "description": "One page of events.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "The cursor of the next page. It is absent on the last page."
          }
        }
      },
      "EventRole": {
        "type": "string",
        "description": "The role of a member in one event.",
        "enum": [
          "event-manager",
          "event-contributor",
          "event-viewer"
        ]
      },
      "Invitation": {
        "type": "object",
        "description": "An invitation to the organization.",
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/OrganizationRole"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InvitationPage": {
        "type": "object",
        "description": "The pending invitations. An organization has few, so the list has one page.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invitation"
            }
          }
        }
      },
      "InvitationPreview": {
        "type": "object",
        "description": "What an invitation is for, before the invitee accepts it.",
        "required": [
          "organization_name",
          "role"
        ],
        "properties": {
          "organization_name": {
            "type": "string",
            "description": "The name of the organization of the invitation."
          },
          "role": {
            "$ref": "#/components/schemas/OrganizationRole",
            "description": "The role that the invitation gives."
          }
        }
      },
      "InvitationTokenRequest": {
        "type": "object",
        "description": "The input of the invitation routes. Like the token of a magic link, the token of an invitation\nreaches the server only in the body of a POST request (ADR 0008).",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the fragment of the invitation link."
          }
        }
      },
      "InviteMemberRequest": {
        "type": "object",
        "description": "The input of `InviteMember`.",
        "required": [
          "email",
          "display_name",
          "role"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The UUIDv7 of the new invitation. A client that sends it can retry the request safely."
          },
          "email": {
            "type": "string",
            "example": "anna@example.org"
          },
          "display_name": {
            "type": "string",
            "description": "1 to 100 characters.",
            "example": "Anna Muster"
          },
          "role": {
            "$ref": "#/components/schemas/OrganizationRole",
            "description": "An owner invites with any role; an admin with admin or member."
          }
        }
      },
      "Member": {
        "type": "object",
        "description": "A member of the organization.",
        "required": [
          "user_id",
          "display_name",
          "role",
          "version"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "The email address. Only owners and admins get it."
          },
          "role": {
            "$ref": "#/components/schemas/OrganizationRole"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "The record version of the organization membership. `RemoveMember` needs it."
          }
        }
      },
      "MemberPage": {
        "type": "object",
        "description": "One page of members.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "The cursor of the next page. It is absent on the last page."
          }
        }
      },
      "MembershipSummary": {
        "type": "object",
        "description": "A membership of the signed-in user.",
        "required": [
          "organization_id",
          "name",
          "role"
        ],
        "properties": {
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "The name of the organization."
          },
          "role": {
            "$ref": "#/components/schemas/OrganizationRole"
          }
        }
      },
      "OrganizationRole": {
        "type": "string",
        "description": "The role of a member in an organization.",
        "enum": [
          "owner",
          "admin",
          "member"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "An error response. `detail` never repeats input values.",
        "required": [
          "type",
          "code",
          "title",
          "status",
          "instance",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "The URL of the code in the public catalog."
          },
          "code": {
            "type": "string",
            "description": "The stable problem code. Clients react to this field. The list of codes is open."
          },
          "title": {
            "type": "string",
            "description": "A short, stable English text for developers."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "An English text about this case, for developers. Clients never show it to members."
          },
          "instance": {
            "type": "string",
            "description": "`urn:uuid:` and the request ID."
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemError"
            },
            "description": "The invalid values of a `validation-failed` problem."
          }
        }
      },
      "ProblemError": {
        "type": "object",
        "description": "One invalid value.",
        "required": [
          "pointer",
          "code"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "description": "A JSON pointer to the value in the request body, for example `/key`."
          },
          "code": {
            "type": "string",
            "description": "The reason, for example `taken`. The list of codes is open."
          }
        }
      },
      "RedeemMagicLinkRequest": {
        "type": "object",
        "description": "The input of a sign-in with a magic link.",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the fragment of the magic link."
          }
        }
      },
      "RemoveEventMembershipRequest": {
        "type": "object",
        "description": "The input of `RemoveEventMembership`.",
        "required": [
          "expected_version"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "RemoveMemberRequest": {
        "type": "object",
        "description": "The input of `RemoveMember`.",
        "required": [
          "expected_version"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "description": "The signed-in user and the organization of the session.",
        "required": [
          "user_id",
          "display_name",
          "memberships"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "organization": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MembershipSummary",
                "description": "The organization of the session. It is absent until the member chooses one (ADR 0056)."
              },
              {
                "type": "null"
              }
            ]
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipSummary"
            },
            "description": "All memberships of the user, in the order of the organization names."
          }
        }
      },
      "SignInRequest": {
        "type": "object",
        "description": "The input of a sign-in request.",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "The email address of the member."
          }
        }
      },
      "TelegramLink": {
        "type": "object",
        "description": "The linked Telegram account.",
        "required": [
          "telegram_user_id"
        ],
        "properties": {
          "telegram_user_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "TelegramLinkCode": {
        "type": "object",
        "description": "A new link code. The member sends it to the bot within ten minutes.",
        "required": [
          "code",
          "expires_at"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The code. It works once. The server shows it only in this response."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TelegramLinkRequest": {
        "type": "object",
        "description": "A Telegram account that sent a code of the member, and that waits for the confirmation.",
        "required": [
          "id",
          "telegram_user_id",
          "telegram_name",
          "claimed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "telegram_user_id": {
            "type": "integer",
            "format": "int64"
          },
          "telegram_name": {
            "type": "string",
            "description": "The name of the Telegram account, as Telegram sends it."
          },
          "claimed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TelegramLinkRequestPage": {
        "type": "object",
        "description": "The open link requests of the member. A member has few, so the list has one page.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TelegramLinkRequest"
            }
          }
        }
      }
    }
  }
}
