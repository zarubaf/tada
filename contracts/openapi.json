  "paths": {
    "/api/v1/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Lists the events that the caller can see, in the order of their keys.",
        "operationId": "list_events",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "The page size: 1 to 200. The default is 50.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 200,
              "minimum": 1
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The `next_cursor` of the previous page.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "malformed-request",
          "unauthenticated",
          "organization-required",
          "unavailable",
          "internal"
        ]
      },
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Creates an event in the caller's organization.",
        "description": "If an event with the same `id` and the same content exists, the response is this event with the\nstatus 200, and nothing changes.",
        "operationId": "create_event",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The event exists with this ID and the same content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "201": {
            "description": "The new event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "default": {
            "description": "A problem (ADR 0037).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-tada-problem-codes": [
          "malformed-request",
          "unauthenticated",
          "organization-required",
          "forbidden",
          "payload-too-large",
          "unsupported-media-type",
          "validation-failed",
          "unavailable",
          "internal"
        ]
      }
    },
